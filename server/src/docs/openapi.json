{
  "openapi": "3.0.3",
  "info": {
    "title": "Campus Commerce Marketplace API",
    "version": "1.0.0",
    "description": "Production-ready REST API for Campus Commerce Marketplace supporting Customer OTP authentication, data-driven service configurations, ride quotes, laundry processing, food orders, vendor operations, and platform administration."
  },
  "servers": [
    {
      "url": "http://localhost:8000/api/v1",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/auth/customer/request-otp": {
      "post": {
        "summary": "Request 6-digit WhatsApp OTP with strict server-enforced throttling",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["phone"],
                "properties": {
                  "phone": { "type": "string", "example": "+919876543210" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "OTP generated and dispatched" },
          "429": { "description": "OTP request rate limited" }
        }
      }
    },
    "/auth/customer/verify-otp": {
      "post": {
        "summary": "Verify OTP and create or log in customer",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["phone", "code"],
                "properties": {
                  "phone": { "type": "string", "example": "+919876543210" },
                  "code": { "type": "string", "example": "123456" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Tokens issued" },
          "400": { "description": "Invalid or expired code" }
        }
      }
    },
    "/marketplace/vendors": {
      "get": {
        "summary": "List marketplace vendors with filters",
        "tags": ["Marketplace"],
        "parameters": [
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "category", "in": "query", "schema": { "type": "string", "enum": ["ride", "laundry", "food"] } },
          { "name": "dietaryClassification", "in": "query", "schema": { "type": "string", "enum": ["VEG_ONLY", "VEG_AND_NON_VEG"] } }
        ],
        "responses": {
          "200": { "description": "Vendor array" }
        }
      }
    },
    "/bookings/ride/quote": {
      "post": {
        "summary": "Calculate authoritative server-side ride fare quote",
        "tags": ["Bookings"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["pickup", "dropoff", "passengers"],
                "properties": {
                  "serviceId": { "type": "string" },
                  "pickup": { "type": "string", "example": "Main Gate" },
                  "dropoff": { "type": "string", "example": "Hostel B" },
                  "passengers": { "type": "integer", "maximum": 2, "example": 1 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Quoted fare amount" },
          "400": { "description": "Invalid location or passenger count" }
        }
      }
    },
    "/bookings": {
      "get": {
        "summary": "List bookings for authenticated user",
        "tags": ["Bookings"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Paginated booking list" }
        }
      },
      "post": {
        "summary": "Create booking (Ride, Laundry, or Food)",
        "tags": ["Bookings"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "201": { "description": "Booking created" },
          "400": { "description": "Validation or restriction violation" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
